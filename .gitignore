# ==========================================
# FatCat Git Ignore Rules
# ==========================================

# SnowLuma Binaries, Native Addons, Runtime and Local Caches
snowluma/

# Local Memory & Browser Profiles (Privacy & Runtime data)
data/agy_session.json
data/memory/*.db*
data/memory/*.sqlite*
data/browser_profiles/*
data/reflection_reports/*.md
!data/memory/.gitkeep
!data/browser_profiles/.gitkeep
!data/reflection_reports/.gitkeep

# Logs and runtime artifacts
*.log
*.tmp

# Dependencies & Local AI proxy caches
node_modules/
.gemini/
__pycache__/

# Windows & OS Artifacts
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
